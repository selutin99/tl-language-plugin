<idea-plugin>
    <id>com.galua.teal.language</id>
    <name>Teal Language Support</name>
    <vendor email="selutin991@gmail.com">Alexander Selyutin</vendor>

    <description>Basic Teal language file support</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Teal"
            language="Teal"
            extensions="tl"
            implementationClass="com.galua.teal.core.TealFileType"/>
        <lang.syntaxHighlighterFactory
            language="Teal"
            implementationClass="com.galua.teal.highlighting.TealSyntaxHighlighterFactory"/>
        <lang.parserDefinition
            language="Teal"
            implementationClass="com.galua.teal.parser.TealParserDefinition"/>
        <annotator
            language="Teal"
            implementationClass="com.galua.teal.annotator.TealAnnotator"/>
        <externalAnnotator
            language="Teal"
            implementationClass="com.galua.teal.annotator.TealCheckAnnotator"/>
        <liveTemplateContext
            contextId="TEAL"
            implementation="com.galua.teal.livetemplates.TealTemplateContextType"/>
        <defaultLiveTemplates file="liveTemplates/Teal"/>
        <notificationGroup
            id="Teal"
            displayType="BALLOON"
            isLogByDefault="true"/>
    </extensions>

    <actions>
        <group
            id="Teal.Context"
            class="com.galua.teal.actions.TealActionGroup"
            text="Teal"
            description="Teal commands"
            popup="true"
            icon="/icons/tealFile.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>

            <action
                id="Teal.Check"
                class="com.galua.teal.actions.impl.TealCheckAction"
                text="check"
                description="Run tl check on the current file"/>
            <action
                id="Teal.Gen"
                class="com.galua.teal.actions.impl.TealGenAction"
                text="gen"
                description="Run tl gen on the current file"/>
            <action
                id="Teal.Run"
                class="com.galua.teal.actions.impl.TealRunAction"
                text="run"
                description="Run tl run on the current file"/>
        </group>
    </actions>

</idea-plugin>
