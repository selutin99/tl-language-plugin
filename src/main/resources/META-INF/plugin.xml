<idea-plugin>
    <id>com.galua.teal.language</id>
    <name>Teal Language Support</name>
    <vendor email="support@example.com">Teal</vendor>

    <description>Basic Teal language file support.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Teal"
            language="Teal"
            extensions="tl"
            implementationClass="com.galua.teal.language.core.TealFileType" />
        <lang.syntaxHighlighterFactory
            language="Teal"
            implementationClass="com.galua.teal.language.highlighting.TealSyntaxHighlighterFactory" />
        <lang.parserDefinition
            language="Teal"
            implementationClass="com.galua.teal.language.parser.TealParserDefinition" />
        <annotator
            language="Teal"
            implementationClass="com.galua.teal.language.annotator.TealAnnotator" />
    </extensions>
</idea-plugin>
