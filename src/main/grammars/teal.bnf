{
  parserClass="com.galua.teal.parser.TealParser"

  implements="com.galua.teal.psi.TealPsiElement"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Teal"
  psiImplClassSuffix="Impl"
  psiPackage="com.galua.teal.psi"
  psiImplPackage="com.galua.teal.psi.impl"
  psiImplUtilClass="com.galua.teal.psi.TealPsiImplUtilKt"

  parserUtilClass="com.galua.teal.psi.TealParserUtil"
  elementTypeHolderClass="com.galua.teal.psi.TealTypes"
  elementTypeClass="com.galua.teal.psi.TealElementType"
  elementTypeFactory="com.galua.teal.lang.TealParserDefinitionKt.createType"
  tokenTypeClass="com.galua.teal.psi.TealTokenType"
  tokenTypeFactory="com.galua.teal.lang.TealParserDefinitionKt.createToken"
  parserImports = [
        "static com.intellij.lang.WhitespacesBinders.*"
        "static com.intellij.lang.parser.GeneratedParserUtilBase.*"
  ]

  tokens = [
        /* Keywords */
        AND = "and"
        BREAK = "break"
        DO = "do"
        ELSE = "else"
        ELSEIF = "elseif"
        END = "end"
        FALSE = "false"
        FOR = "for"
        FUNCTION = "function"
        GLOBAL = "global"
        IF = "if"
        IN = "in"
        INTERFACE = "interface"
        LOCAL = "local"
        NIL = "nil"
        NOT = "not"
        OR = "or"
        REPEAT = "repeat"
        REQUIRE = "require"
        RECORD = "record"
        RETURN = "return"
        THEN = "then"
        TRUE = "true"
        TYPE = "type"
        UNTIL = "until"
        USERDATA = "userdata"
        WHERE = "where"
        WHILE = "while"
        ENUM = "enum"
        AS = "as"
        IS = "is"
        METAMETHOD = "metamethod"
        REGION = "REGION"
        ENDREGION = "ENDREGION"

        SHEBANG = "#!"
        SHEBANG_CONTENT = "SHEBANG_CONTENT"
        ELLIPSIS = "..."
        CONCAT = ".."
        EQ = "=="
        GE = ">="
        LE = "<="
        NE = "~="
        MINUS = "-"
        PLUS = "+"
        MULT = "*"
        MOD = "%"
        DIV = "/"
        ASSIGN = "="
        GT = ">"
        LT = "<"
        LPAREN = "("
        RPAREN = ")"
        LBRACK = "["
        RBRACK = "]"
        LCURLY = "{"
        RCURLY = "}"
        QUESTION = "?"
        GETN = "#"
        COMMA = ","
        SEMI = ";"
        COLON = ":"
        DOT = "."
        EXP = "^"

        SHORT_COMMENT="SHORT_COMMENT"
        DOC_COMMENT="DOC_COMMENT"
        BLOCK_COMMENT="BLOCK_COMMENT"
        ID="regexp:[A-Za-z_][A-Za-z0-9_]*"
        NUMBER="NUMBER"
        STRING = "STRING"

        // lua 5.3
        DOUBLE_COLON = "::"
        GOTO = "goto"
        BIT_OR = "|"
        BIT_AND = "&"
        BIT_LTLT = "<<"
        BIT_RTRT = ">>"
        BIT_TILDE = "~"
        DOUBLE_DIV = "//"
  ]

  hooks("localDef|assignStat|tableField") = [leftBinder="MY_LEFT_COMMENT_BINDER" rightBinder="MY_RIGHT_COMMENT_BINDER"]
  hooks("funcDef|localFuncDef|classMethodDef") = [leftBinder="MY_LEFT_COMMENT_BINDER"]
  hooks("fieldList") = [leftBinder="GREEDY_LEFT_BINDER" rightBinder="GREEDY_RIGHT_BINDER"]
  extends(".*Expr") = expr
  extends(".*Stat") = statement
  hooks(".*Stat") = [leftBinder="MY_LEFT_COMMENT_BINDER"]
}

tealFile ::= shebang_line? stat_semi*

shebang_line ::= SHEBANG SHEBANG_CONTENT

private stat_semi ::= <<parseStatement>>
block ::= stat_semi* {
    implements = [
        "com.galua.teal.psi.TealDeclarationScope"
    ]
}

fake statement ::= () {
    implements = "com.galua.teal.psi.TealCommentOwner"
}
private stat_impl ::=
    emptyStat |
    doStat |
    whileStat |
    repeatStat |
    ifStat |
    forAStat |
    forBStat |
    defStat |
    lastStat |
    labelStat |
    gotoStat |
    typedVarStat |
    assignStat |
    exprStat {
        recoverWhile = stat_recover
    }
private stat_recover ::= !(ID
    | ',' | ';'
    | 'local' | 'global' | 'type' | 'record' | 'interface' | 'enum'
    | 'where' | 'userdata' | 'metamethod' | 'require'
    | 'do' | 'while' | 'repeat' | 'function' | 'if' | 'for' | 'return' | break
    | nil | true | false | STRING | NUMBER | '::' | 'goto'
    | unaryOp)

emptyStat ::= ';'

varList ::= varExpr (',' varExpr)* {
    extends = exprList
}
assignStat ::= varList '=' exprList {
    pin = 2
    implements = [
        "com.galua.teal.psi.TealDeclaration"
    ]
    methods = [assign = 'ASSIGN' varExprList = '/exprList[0]' valueExprList = '/exprList[1]']
    mixin = "com.galua.teal.psi.impl.TealStatMixin<com.galua.teal.stubs.TealPlaceholderStub>"
}
doStat ::= 'do' <<lazyBlock>> 'end' {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealIndentRange"
    ]
    mixin = "com.galua.teal.psi.impl.TealStatMixin<com.galua.teal.stubs.TealPlaceholderStub>"
}
whileStat ::= 'while' expr 'do' <<lazyBlock>> 'end' {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealLoop"
        "com.galua.teal.psi.TealIndentRange"
    ]
}
repeatStat ::= 'repeat' <<lazyBlock>> 'until' expr {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealLoop"
        "com.galua.teal.psi.TealIndentRange"
        "com.galua.teal.psi.TealDeclarationScope"
    ]
    methods = [
        until = 'UNTIL'
    ]
}
ifStat ::= 'if' expr 'then' <<lazyBlock>> ('elseif' expr 'then' <<lazyBlock>>)* ('else' <<lazyBlock>>)? 'end' {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealIndentRange"
    ]
    mixin = "com.galua.teal.psi.impl.TealStatMixin<com.galua.teal.stubs.TealPlaceholderStub>"
}
forAStat ::= 'for' paramNameDef '=' expr ',' expr (',' expr)? 'do' <<lazyBlock>> 'end' {
    pin = 3
    methods = [getParamNameDefList]
    implements = [
        "com.galua.teal.psi.TealParametersOwner"
        "com.galua.teal.psi.TealLoop"
        "com.galua.teal.psi.TealIndentRange"
        "com.galua.teal.psi.TealDeclarationScope"
    ]
}
forBStat ::= 'for' parList 'in' exprList 'do' <<lazyBlock>> 'end' {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealParametersOwner"
        "com.galua.teal.psi.TealLoop"
        "com.galua.teal.psi.TealIndentRange"
        "com.galua.teal.psi.TealDeclarationScope"
    ]
}
labelStat ::= '::' ID '::' {
    pin = 1
    implements = [
        "com.intellij.psi.PsiNameIdentifierOwner"
    ]
    mixin = "com.galua.teal.psi.impl.TealNamedElementMixin"
    methods = [
        getNameIdentifier
        getTextOffset
        setName
        getName
    ]
}
gotoStat ::= 'goto' ID {
    pin = 1
    methods = [
        getReferences
    ]
}
private defStat ::= classMethodDef | funcDef | localFuncDef | globalFuncDef | typeAliasStat | recordStat | interfaceStat | enumStat | localDef | globalDef
exprStat ::= expr {
    mixin = "com.galua.teal.psi.impl.TealStatMixin<com.galua.teal.stubs.TealPlaceholderStub>"
}

funcDef ::= 'function' ID funcBody {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealClassMethod"
        "com.galua.teal.psi.TealDeclaration"
        "com.galua.teal.psi.TealStatement"
    ]
    methods = [
        getComment
        getPresentation
        getParamNameDefList
        getNameIdentifier
        setName
        getName
        getTextOffset
        toString
        guessReturnType
        guessParentType
        getVisibility
        getWorth
        isDeprecated
        getParams
        getReferences
    ]
}

left funcPrefixRef ::= '.' ID { extends = indexExpr elementType = indexExpr }
classMethodName ::=  nameExpr (funcPrefixRef)* (('.' ID) | (':' ID)) {
    pin = 1
    methods = [
        dot = 'DOT'
        colon = 'COLON'
    ]
}
classMethodDef ::= 'function' classMethodName funcBody {
    pin = 2
    implements = [
        "com.galua.teal.psi.TealClassMethod"
        "com.galua.teal.psi.TealDeclaration"
        "com.galua.teal.psi.TealStatement"
    ]
    methods = [
        getComment
        guessParentType
        getVisibility
        getWorth
        isDeprecated
        getParamNameDefList
        getNameIdentifier
        setName
        getName
        getTextOffset
        toString
        guessReturnType
        getParams
        isStatic
        getPresentation
    ]
}

localFuncDef ::= 'local' 'function' ID funcBody {
    pin = 2
    implements = [
        "com.galua.teal.psi.TealFuncBodyOwner"
        "com.galua.teal.psi.TealDeclaration"
        "com.galua.teal.psi.TealStatement"
        "com.intellij.psi.PsiNameIdentifierOwner"
    ]
    mixin = "com.galua.teal.psi.impl.TealNamedStubMixin<com.galua.teal.stubs.TealLocalFuncDefStub>"
    methods = [
        getComment
        getParamNameDefList
        getNameIdentifier
        setName
        getName
        getTextOffset
        getUseScope
        guessReturnType
        getParams
    ]
}
globalFuncDef ::= 'global' 'function' ID funcBody {
    pin = 2
    implements = [
        "com.galua.teal.psi.TealFuncBodyOwner"
        "com.galua.teal.psi.TealDeclaration"
        "com.galua.teal.psi.TealStatement"
        "com.intellij.psi.PsiNameIdentifierOwner"
    ]
    mixin = "com.galua.teal.psi.impl.TealNamedElementMixin"
    methods = [
        getComment
        getParamNameDefList
        getNameIdentifier
        setName
        getName
        getTextOffset
        guessReturnType
        getParams
    ]
}
attribute ::= '<' ID '>' {
    pin = 1
}
nameList ::= nameDef attribute? (',' nameDef attribute?)* {
}
typeListAnn ::= ':' typeexpList {
    pin = 1
}
localDef ::= 'local' nameList typeListAnn? ('=' exprList)? {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealDeclaration"
        "com.galua.teal.psi.TealStatement"
        "com.galua.teal.psi.TealDeclarationScope"
    ]
    methods = [getComment assign = 'ASSIGN']
}
globalDef ::= 'global' nameList (typeListAnn ('=' exprList)? | '=' exprList) {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealDeclaration"
        "com.galua.teal.psi.TealStatement"
        "com.galua.teal.psi.TealDeclarationScope"
    ]
    methods = [getComment assign = 'ASSIGN']
}

typedVar ::= varExpr typeAnn
typedVarList ::= typedVar (',' typedVar)*
typedVarStat ::= typedVarList ('=' exprList)? {
    pin = 1
}

typeAliasStat ::= localTypeAliasStat | globalTypeAliasStat
localTypeAliasStat ::= 'local' 'type' typeNameDef '=' newType {
    pin = 2
}
globalTypeAliasStat ::= 'global' 'type' typeNameDef ('=' newType)? {
    pin = 2
}

private visibility ::= 'local' | 'global'

recordStat ::= visibility? 'record' typeNameDef recordBody {
    pin = 2
}
recordBody ::= typeParams? ('is' interfaceList)? ('where' expr)? recordEntry* 'end' {
    pin(".*") = 1
}
interfaceList ::= interfaceType (',' interfaceType)*
private interfaceType ::= nominalType | typeArray | 'userdata'
recordEntry ::= 'userdata'
    | 'type' typeNameDef '=' newType
    | 'metamethod'? recordKey ':' typeexp
    | 'record' typeNameDef recordBody
    | 'enum' typeNameDef enumBody
recordKey ::= ID | '[' STRING ']'

interfaceStat ::= visibility? 'interface' typeNameDef recordBody {
    pin = 2
}

enumStat ::= visibility? 'enum' typeNameDef enumBody {
    pin = 2
}
enumBody ::= STRING* 'end' {
    pin(".*") = 1
}

newType ::= 'record' recordBody
    | 'enum' enumBody
    | requireType
    | typeexp
requireType ::= 'require' '(' STRING ')' ('.' ID)*

returnStat ::= return exprList? {
    mixin = "com.galua.teal.psi.impl.TealStatMixin<com.galua.teal.stubs.TealPlaceholderStub>"
}
breakStat ::= break
private lastStat ::= returnStat | breakStat

exprList ::= expr (',' expr)* {
    methods = [guessTypeAt]
}

typeAnn ::= ':' typeexp {
    pin = 1
}
typeNameDef ::= ID

typeexp ::= typeUnion

private typeUnion ::= typePostfix ('|' typePostfix)*

private typePostfix ::= typePrimary typeOptional?
typeOptional ::= '?'

private typePrimary ::= typeFunction
    | typeMap
    | typeTuple
    | typeArray
    | typeParen
    | typeNameRef

typeParen ::= '(' typeexp ')' {
    pin = 1
}

typeNameRef ::= nominalType
nominalType ::= typeName ('.' typeName)* typeGenericArgs?
typeName ::= ID | 'self' | 'any' | 'nil'
typeGenericArgs ::= '<' typeexpList '>' {
    pin = 1
}
typeParams ::= '<' typeNameDef (',' typeNameDef)* '>' {
    pin = 1
}

typeexpList ::= typeexp (',' typeexp)*

typeFunction ::= 'function' typeParams? typeFuncParams typeFuncReturns?
typeFuncParams ::= '(' partypeList? ')' {
    pin = 1
}
typeFuncReturns ::= ':' retList
retList ::= '(' typeexpList? '...'? ')' | typeexpList '...'?
partypeList ::= partype (',' partype)*
partype ::= ID '?'? ':' typeexp | '?'? typeexp

typeArray ::= '{' typeexp '}' {
    pin = 1
}
typeMap ::= '{' typeexp ':' typeexp '}' {
    pin = 1
}
typeTuple ::= '{' typeexp (',' typeexp)+ '}' {
    pin = 1
}

funcReturnType ::= ':' retList {
    pin = 1
}

literalExpr ::= nil | false | true | NUMBER | STRING | "..." {
    mixin = 'com.galua.teal.psi.impl.TealLiteralExprMixin'
}
stringExpr ::= STRING {
    extends = literalExpr
    elementType = literalExpr
}

private varExpr ::= nameExpr indexExpr*

expr ::= <<parseExpr>> {
    mixin = "com.galua.teal.psi.impl.TealExprMixin"
    implements = [
        "com.galua.teal.psi.TealTypeGuessable"
    ]
}

parenExpr ::= '(' expr ')' {
    pin = 1
    mixin = "com.galua.teal.psi.impl.TealParenExprMixin"
}
unaryExpr ::= unaryOp (unaryExpr | primaryExpr) {
    pin = 1
    mixin = "com.galua.teal.psi.impl.TealUnaryExprMixin"
}

left binaryExpr ::= binaryOp expr {
    pin = 1
    mixin = "com.galua.teal.psi.impl.TealBinaryExprMixin"
}

left indexExpr ::= '[' expr ']' | '.' ID | ':' ID {
    pin(".*") = 1
    methods = [
        getNameIdentifier
        setName
        getName
        getTextOffset
        getPresentation
        getIdExpr
        toString

        guessParentType
        isDeprecated

        dot = 'DOT'
        colon = 'COLON'
        lbrack = 'LBRACK'
    ]
    implements = [
        "com.intellij.psi.PsiNameIdentifierOwner"
        "com.galua.teal.psi.TealClassMember"
    ]
    mixin = "com.galua.teal.psi.impl.TealIndexExprMixin"
}

args ::= listArgs | singleArg {
}
singleArg ::= tableExpr | stringExpr { extends = args }
private arg_expr ::= <<parseExpr>>
private arg_expr_list ::= arg_expr (',' arg_expr)* ','? { pin = 1 }
listArgs ::= '(' (arg_expr_list)? ')' { extends = args pin = 1 }

left callExpr ::= args {
    methods = [
        guessParentType
        getFirstStringArg

        isMethodDotCall
        isMethodColonCall
        isFunctionCall
    ]
    mixin = 'com.galua.teal.psi.impl.TealCallExprMixin'
}

private suffixExpr ::= indexExpr | callExpr
private prefixExpr ::= parenExpr | nameExpr | tableExpr | literalExpr
// prefixExpr | callExpr | indexExpr
private primaryExpr ::= prefixExpr (suffixExpr*)

closureExpr ::= 'function' funcBody {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealFuncBodyOwner"
    ]
    methods = [getParamNameDefList guessReturnType getParams]
    mixin = 'com.galua.teal.psi.impl.TealClosureExprMixin'
}

funcBody ::= typeParams? '(' (parList)? ')' funcReturnType? <<lazyBlock>>? 'end' {
    pin = 1
    implements = [
        "com.galua.teal.psi.TealIndentRange"
        "com.galua.teal.psi.TealDeclarationScope"
    ]
    methods = [
        RPAREN = 'RPAREN'
        ELLIPSIS = 'ELLIPSIS'
    ]
}

private parList ::= paramDef (',' paramDef)* (',' '...' typeAnn?)? | '...' typeAnn? { recoverWhile = parList_recover }
private parList_recover ::= !(')'|'in')

tableExpr ::= '{' fieldList '}' {
    pin = 1
    methods = [
        findField
    ]
    implements = [
        "com.galua.teal.psi.TealIndentRange"
    ]
    mixin = "com.galua.teal.psi.impl.TealTableExprMixin"
}

private fieldList ::= (tableField (tableFieldSep tableField)* (tableFieldSep)?)?

private tableField1 ::= '[' expr ']' '=' expr { pin = 1 }
private tableField2 ::= ID typeAnn? '=' expr { pin = 2 }

tableField ::= tableField1 | tableField2 | expr {
    methods = [
        getNameIdentifier
        setName
        getName
        getTextOffset

        toString

        getFieldName
        getPresentation
        guessParentType
        getVisibility
        getWorth
        isDeprecated
        getComment
        getIdExpr
        nameDef = "tableFieldNameDef"
        lbrack = 'LBRACK'
    ]
    mixin = "com.galua.teal.psi.impl.TealNamedStubMixin<com.galua.teal.stubs.TealTableFieldStub>"
    implements = [
        "com.galua.teal.psi.TealClassField"
        "com.intellij.psi.PsiNameIdentifierOwner"
        "com.galua.teal.psi.TealCommentOwner"
    ]
    recoverWhile = tableField_recover
}

private tableField_recover ::= !(tableFieldSep | '}' | '[')

tableFieldSep ::= ',' | ';'

binaryOp ::= '+' | '-' | '*' | '/' | '^' | '%' | '..' |
    '<' | '<=' | '>' | '>=' | '==' | '~=' |
    'and' | 'or'
    // lua5.3
    | '|' | '&' | '>>' | '<<' | '~' | '//'

unaryOp ::= '-' | 'not' | '#'
    // lua5.3
    | '~'

nameDef ::= ID {
    implements = [
        "com.galua.teal.psi.TealNamedElement"
        "com.galua.teal.psi.TealTypeGuessable"
        "com.intellij.psi.PsiNameIdentifierOwner"
    ]
    mixin = "com.galua.teal.psi.impl.TealNamedStubMixin<com.galua.teal.stubs.TealNameDefStub>"
    methods = [
        getName
        setName
        getNameIdentifier
        getUseScope
    ]
}
nameExpr ::= ID {
    implements = [
        "com.galua.teal.psi.TealPsiElement"
        "com.intellij.psi.PsiNameIdentifierOwner"
        "com.galua.teal.psi.TealModuleClassField"
    ]
    methods = [
        setName
        getName
        getNameIdentifier
        getPresentation
        getReferences
        isDeprecated

        toString
    ]
    mixin = "com.galua.teal.psi.impl.TealNameExprMixin"
}
paramNameDef ::= ID {
    extends = nameDef
}
paramDef ::= paramNameDef '?'? typeAnn?
